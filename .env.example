# SalesDesk production environment
# Never commit real secret values. Configure them in Vercel Project Settings > Environment Variables.

# Supabase server-side access
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Automated Razorpay subscriptions
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_rotated_live_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_PLAN_INR_MONTHLY=plan_your_inr_monthly
RAZORPAY_PLAN_INR_ANNUAL=plan_your_inr_annual
RAZORPAY_PLAN_USD_MONTHLY=plan_your_usd_monthly
RAZORPAY_PLAN_USD_ANNUAL=plan_your_usd_annual

# SalesDesk owner/admin accounts allowed to review manual fallback payments.
# SALES_DESK_ADMIN_EMAILS is preferred. MODEFLOW_ADMIN_EMAILS remains supported for compatibility.
SALES_DESK_ADMIN_EMAILS=owner@example.com
MODEFLOW_ADMIN_EMAILS=

# Manual UPI fallback. Automated Razorpay checkout should be the primary production path.
# SALES_DESK_UPI_* is preferred; MODEFLOW_UPI_* remains supported for compatibility.
SALES_DESK_UPI_ID=yourname@upi
SALES_DESK_UPI_PAYEE_NAME=SalesDesk
MODEFLOW_UPI_ID=
MODEFLOW_UPI_PAYEE_NAME=

# Public support identity used in operational runbooks / deployment setup.
SALES_DESK_SUPPORT_EMAIL=support@your-own-domain.com

# Live tenant-isolation verification. Use dedicated TEST accounts only.
SUPABASE_ANON_KEY=your_publishable_anon_key
SALESDESK_TEST_A_EMAIL=test-a@example.com
SALESDESK_TEST_A_PASSWORD=use_a_dedicated_test_password
SALESDESK_TEST_B_EMAIL=test-b@example.com
SALESDESK_TEST_B_PASSWORD=use_a_dedicated_test_password

# k6 staging/load-test configuration
BASE_URL=https://your-staging-domain.example
TEST_EMAIL=load-test@example.com
TEST_PASSWORD=use_a_dedicated_test_password
TEST_BUSINESS_ID=staging_business_uuid
TEST_PRODUCT_ID=staging_product_uuid
ALLOW_TRANSACTION_WRITES=false
ALLOW_PRODUCTION_LOAD=false
